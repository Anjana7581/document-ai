          "body": "{\n  \"success\": true,\n  \"document_id\": \"doc_1a2b3c4d5e6f\",\n  \"status\": \"indexed\",\n  \"document\": {\n    \"document_id\": \"doc_1a2b3c4d5e6f\",\n    \"filename\": \"course_details.pdf\",\n    \"extension\": \".pdf\",\n    \"size_bytes\": 20480,\n    \"status\": \"indexed\",\n    \"chunk_count\": 12,\n    \"page_count\": 4,\n    \"created_at\": \"2026-10-27T10:00:00+00:00\",\n    \"updated_at\": \"2026-10-27T10:00:30+00:00\",\n    \"indexed_at\": \"2026-10-27T10:00:30+00:00\",\n    \"error\": null\n  },\n  \"message\": \"Document re-indexed.\",\n  \"chunks_indexed\": 12\n}"
