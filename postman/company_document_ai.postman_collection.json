            "key": "X-API-Key",
            "value": "{{api_key}}",
            "description": "Only needed if API_KEY is set in .env"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/documents/{{document_id}}/reindex",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "documents",
            "{{document_id}}",
            "reindex"
          ]
        },
        "description": "Optional: in Body > form-data add key 'file' (same file type) to replace the stored file. With no body it re-reads the stored file. Old chunks are replaced only after the new ones are saved.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": [],
              "disabled": true
            }
          ]
        }
      },
      "response": [
        {
          "name": "Example response",
          "originalRequest": {
