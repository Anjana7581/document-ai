FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
DOCUMENT_STORAGE_PATH=./storage/documents
VECTOR_DB_PATH=./storage/vector_db
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=5
MAX_UPLOAD_MB=25
LLM_TIMEOUT_SECONDS=120
EMBED_TIMEOUT_SECONDS=120
# Max cosine distance for a chunk to count as relevant (lower = stricter)
RELEVANCE_MAX_DISTANCE=0.9
# Leave empty for local testing. Set a long random value before any public deployment.
API_KEY=
